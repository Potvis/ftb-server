# Required secrets. Generate each with: openssl rand -base64 32
RCON_PASSWORD=replace-with-a-long-random-password
RWA_PASSWORD=replace-with-a-different-long-random-password

# All the Mods 10 / CurseForge (default)
MODPACK_PLATFORM=AUTO_CURSEFORGE
CF_SLUG=all-the-mods-10

# Optional: pin a release. Leave both empty to track the latest release.
CF_FILE_ID=
CF_FILENAME_MATCHER=

# Optional on Java 17+; use your own key if CurseForge requests one.
CF_API_KEY=

# Uncomment these instead to run an FTB pack.
# MODPACK_PLATFORM=FTBA
# FTB_MODPACK_ID=88
# FTB_MODPACK_VERSION_ID=100026

JAVA_VERSION=21
INIT_MEMORY=4G
MAX_MEMORY=12G
CONTAINER_MEMORY_LIMIT=14g
CONTAINER_MEMORY_RESERVATION=12g
MC_UID=1000
MC_GID=1000
TZ=Europe/Brussels

# Web UI binds to localhost by default. Use a LAN IP or 0.0.0.0 only when
# protected by a firewall and preferably an HTTPS reverse proxy.
RCON_WEB_BIND=127.0.0.1
RCON_WEB_PORT=4326
RCON_WEBSOCKET_PORT=4327
RWA_USERNAME=admin
